---
import '@fontsource-variable/oswald';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { languages, htmlLang, ogLocale, localize, withBase, t, type Lang } from '../i18n';
import { club, schedule } from '../data/site';
import logo from '../../images/logo.jpg';
import ogPhoto from '../../images/photo2.png';

interface Props {
  lang: Lang;
  /** Path without language prefix, e.g. '/' or '/impressum/' */
  path: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  isHome?: boolean;
}

const { lang, path, title, description, noindex = false, isHome = false } = Astro.props;
const d = t(lang);
const pageTitle = title ? `${title} | ${club.name}` : d.meta.title;
const pageDesc = description ?? d.meta.description;
const site = Astro.site!;
const canonical = new URL(localize(lang, path), site).href;

const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: logo, width: 150, height: 150, format: 'png' });
const og = await getImage({ src: ogPhoto, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, site).href;

const dayCode = { tue: 'Tuesday', fri: 'Friday' } as const;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: club.name,
  url: new URL(localize('de', '/'), site).href,
  logo: new URL(touchIcon.src, site).href,
  image: ogUrl,
  telephone: club.phone,
  email: club.email,
  sameAs: [club.instagram],
  address: {
    '@type': 'PostalAddress',
    streetAddress: club.street,
    postalCode: club.zip,
    addressLocality: club.city,
    addressCountry: 'CH',
  },
  openingHoursSpecification: schedule.map((s) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${dayCode[s.day]}`,
    opens: s.start,
    closes: s.end,
  })),
};
---

<!doctype html>
<html lang={htmlLang[lang]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#0e0e0e" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {languages.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localize(l, path), site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localize('de', path), site).href} />

    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="twitter:card" content="summary_large_image" />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header lang={lang} path={path} isHome={isHome} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFab lang={lang} />

    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
