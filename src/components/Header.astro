---
import { Image } from 'astro:assets';
import { languages, localize, t, type Lang } from '../i18n';
import logo from '../../images/logo.jpg';

interface Props { lang: Lang; path: string; isHome: boolean }
const { lang, path, isHome } = Astro.props;
const d = t(lang);
const home = localize(lang, '/');
const anchor = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);

const links = [
  { id: 'about', label: d.nav.about },
  { id: 'training', label: d.nav.disciplines },
  { id: 'schedule', label: d.nav.schedule },
  { id: 'coach', label: d.nav.coach },
  { id: 'prices', label: d.nav.prices },
  { id: 'faq', label: d.nav.faq },
  { id: 'contact', label: d.nav.contact },
];
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="brand" href={home} aria-label="STRIKEBULL MMA Club – Home">
      <Image src={logo} alt="" width={48} height={48} class="brand__logo" loading="eager" />
      <span class="brand__text">
        <span class="brand__name">Strikebull</span>
        <span class="brand__sub">MMA Club Chur</span>
      </span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Main" data-nav>
      <ul class="nav__list">
        {links.map((l) => (
          <li><a href={anchor(l.id)} class="nav__link" data-nav-link>{l.label}</a></li>
        ))}
      </ul>
      <div class="nav__mobile-extra">
        <a href={anchor('contact')} class="btn btn--block" data-nav-link>{d.hero.cta}</a>
      </div>
    </nav>

    <div class="header__actions">
      <div class="langs" aria-label="Language">
        {languages.map((l) => (
          <a
            href={localize(l, path)}
            hreflang={l}
            lang={l}
            class:list={['langs__link', { 'is-active': l === lang }]}
            aria-current={l === lang ? 'true' : undefined}
            title={t(l).meta.langName}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
      <a href={anchor('contact')} class="btn header__cta">{d.nav.cta}</a>
      <button
        class="burger"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label={d.nav.menu}
        data-label-open={d.nav.menu}
        data-label-close={d.nav.close}
        data-burger
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    height: var(--header-h);
  }
  /* Background lives on a pseudo-element: backdrop-filter on .header itself would
     become the containing block for the position:fixed mobile nav and squash it. */
  .header::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: rgba(14, 14, 14, 0.92);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 var(--line);
    opacity: 0; transition: opacity 0.3s;
  }
  .header.is-scrolled::before, .header.is-open::before { opacity: 1; }
  .header__inner { height: 100%; display: flex; align-items: center; gap: 24px; }

  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex-shrink: 0; }
  .brand__logo { width: 48px; height: 48px; border-radius: 50%; box-shadow: 0 0 0 1.5px var(--gold); }
  .brand__text { display: flex; flex-direction: column; line-height: 1; }
  .brand__name {
    font-family: var(--font-head); font-weight: 700; font-size: 1.35rem;
    letter-spacing: 0.06em; text-transform: uppercase;
    background: var(--gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .brand__sub {
    font-family: var(--font-head); font-size: 0.7rem; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--muted); margin-top: 4px;
  }

  .nav { margin-left: auto; }
  .nav__list { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav__link {
    display: block; padding: 8px 10px;
    font-family: var(--font-head); font-size: 0.95rem; letter-spacing: 0.08em;
    text-transform: uppercase; text-decoration: none; color: var(--text);
    position: relative;
  }
  .nav__link::after {
    content: ''; position: absolute; left: 10px; right: 10px; bottom: 2px; height: 2px;
    background: var(--red); transform: scaleX(0); transform-origin: left; transition: transform 0.25s;
  }
  .nav__link:hover::after, .nav__link.is-active::after { transform: scaleX(1); }
  .nav__mobile-extra { display: none; }

  .header__actions { display: flex; align-items: center; gap: 16px; }
  .langs { display: flex; border: 1px solid var(--line); }
  .langs__link {
    padding: 6px 9px; font-family: var(--font-head); font-size: 0.8rem; letter-spacing: 0.1em;
    text-decoration: none; color: var(--muted);
  }
  .langs__link:hover { color: var(--text); }
  .langs__link.is-active { background: var(--gold); color: #111; font-weight: 600; }
  .header__cta { min-height: 42px; padding: 0 18px; font-size: 0.9rem; }

  .burger {
    display: none; width: 44px; height: 44px; padding: 11px 10px;
    background: none; border: 1px solid var(--line); cursor: pointer;
    flex-direction: column; justify-content: space-between;
  }
  .burger span { display: block; height: 2px; background: var(--text); transition: transform 0.3s, opacity 0.3s; }
  .is-open .burger span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .is-open .burger span:nth-child(2) { opacity: 0; }
  .is-open .burger span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

  @media (max-width: 1120px) {
    .header__cta { display: none; }
  }
  @media (max-width: 980px) {
    .burger { display: flex; }
    .nav {
      position: fixed; inset: var(--header-h) 0 0 0;
      background: var(--bg);
      padding: 24px var(--gutter) 40px;
      overflow-y: auto;
      opacity: 0; visibility: hidden; transform: translateY(-8px);
      transition: opacity 0.25s, transform 0.25s, visibility 0.25s;
    }
    .is-open .nav { opacity: 1; visibility: visible; transform: none; }
    .nav__list { flex-direction: column; gap: 0; }
    .nav__link { font-size: 1.6rem; padding: 14px 0; border-bottom: 1px solid var(--line-soft); }
    .nav__link::after { display: none; }
    .nav__mobile-extra { display: block; margin-top: 32px; }
    .header__actions { margin-left: auto; }
  }
  @media (max-width: 420px) {
    .brand__sub { display: none; }
    .brand__name { font-size: 1.1rem; }
    .brand__logo { width: 40px; height: 40px; }
    .header__actions { gap: 10px; }
    .langs__link { padding: 6px 7px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 20);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', (open ? burger.dataset.labelClose : burger.dataset.labelOpen) ?? '');
    document.body.style.overflow = open ? 'hidden' : '';
  };
  burger.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
  document.querySelectorAll('[data-nav-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  // highlight current section in nav
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav__link')];
  const sections = links
    .map((a) => document.getElementById(a.hash.slice(1)))
    .filter((s): s is HTMLElement => !!s);
  if (sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.toggle('is-active', a.hash === `#${e.target.id}`));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
