---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n';
import photo from '../../../images/trainer.png';

interface Props { lang: Lang }
const d = t(Astro.props.lang);
---

<section id="coach" class="section">
  <div class="container coach">
    <div class="coach__media reveal">
      <div class="coach__oct">
        <div class="coach__oct-inner photo">
          <Image src={photo} alt={d.coach.name} widths={[600, 857]} sizes="(max-width: 860px) 80vw, 420px" />
        </div>
      </div>
      <p class="coach__since" aria-hidden="true"><span>since</span>2014</p>
    </div>

    <div class="coach__text reveal">
      <p class="label">{d.coach.label}</p>
      <h2 class="h2">{d.coach.title}</h2>
      <h3 class="coach__name">{d.coach.name}</h3>
      <p class="coach__role">{d.coach.role}</p>
      <p class="coach__bio">{d.coach.text}</p>
      <ul class="coach__facts">
        {d.coach.facts.map((f) => <li><Icon name="check" size={18} /> {f}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .coach { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(40px, 7vw, 96px); align-items: center; }

  .coach__media { position: relative; max-width: 440px; width: 100%; margin-inline: auto; }
  .coach__oct {
    --oct: polygon(29% 0, 71% 0, 100% 29%, 100% 71%, 71% 100%, 29% 100%, 0 71%, 0 29%);
    aspect-ratio: 1; padding: 3px; background: var(--gold-grad); clip-path: var(--oct);
  }
  .coach__oct-inner { width: 100%; height: 100%; clip-path: var(--oct); }
  .coach__oct-inner :global(img) { object-position: 47% 50%; transform: scale(1.2); transform-origin: 47% 30%; }
  .coach__oct-inner::after { background: radial-gradient(circle at 50% 40%, transparent 45%, rgba(14,14,14,0.55) 100%); }

  .coach__since {
    position: absolute; right: -8px; bottom: 6%;
    display: flex; flex-direction: column; align-items: center;
    padding: 12px 18px; background: var(--red);
    font-family: var(--font-head); font-weight: 700; font-size: 1.8rem; line-height: 1;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  .coach__since span { font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 500; margin-bottom: 4px; }

  .coach__name { font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin-top: 28px; color: var(--gold); }
  .coach__role {
    font-family: var(--font-head); letter-spacing: 0.22em; text-transform: uppercase;
    font-size: 0.9rem; color: var(--muted); margin-top: 6px;
  }
  .coach__bio { margin-top: 20px; color: #d8d2c6; max-width: 58ch; }
  .coach__facts { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .coach__facts li {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; background: var(--surface); border: 1px solid var(--line); font-size: 0.92rem;
  }
  .coach__facts :global(svg) { color: var(--gold); }

  @media (max-width: 860px) {
    .coach { grid-template-columns: 1fr; }
    .coach__media { max-width: 340px; }
  }
</style>
