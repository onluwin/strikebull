---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n';
import photo from '../../../images/photo2.png';

interface Props { lang: Lang }
const d = t(Astro.props.lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg photo" aria-hidden="true">
    <Image src={photo} alt="" widths={[480, 713]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>

  <div class="container hero__grid">
    <div class="hero__content">
      <p class="label">{d.hero.kicker}</p>
      <h1 id="hero-title" class="hero__title">
        <span>{d.hero.titleA}</span>
        <span class="gold-text">{d.hero.titleB}</span>
      </h1>
      <p class="hero__lead">{d.hero.lead}</p>
      <div class="hero__actions">
        <a href="#contact" class="btn">{d.hero.cta} <Icon name="arrow" size={20} /></a>
        <a href="#schedule" class="btn btn--ghost">{d.hero.secondary}</a>
      </div>
      <ul class="hero__badges">
        {d.hero.badges.map((b) => (
          <li><Icon name="check" size={18} /> {b}</li>
        ))}
      </ul>
    </div>

    <div class="hero__media">
      <div class="frame">
        <div class="photo hero__photo">
          <Image src={photo} alt={d.gallery.alt[1]} widths={[480, 713]} sizes="(max-width: 860px) 0px, 40vw" loading="eager" />
        </div>
      </div>
      <div class="hero__slash" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate;
    min-height: 100svh;
    display: flex; align-items: center;
    padding-block: calc(var(--header-h) + 48px) 72px;
    overflow: hidden;
  }
  .hero__bg { position: absolute; inset: 0; z-index: -1; }
  .hero__bg img { filter: saturate(0.6) brightness(0.35) blur(3px); transform: scale(1.06); }
  .hero__bg::after {
    background:
      radial-gradient(ellipse at 75% 40%, rgba(179, 18, 27, 0.18), transparent 60%),
      linear-gradient(90deg, rgba(14, 14, 14, 0.96) 0%, rgba(14, 14, 14, 0.8) 50%, rgba(14, 14, 14, 0.6) 100%),
      linear-gradient(180deg, transparent 70%, var(--bg) 100%);
  }

  .hero__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 6vw, 80px); align-items: center; }

  .hero__title { font-size: clamp(3.2rem, 9vw, 7rem); line-height: 0.95; font-weight: 700; }
  .hero__title span { display: block; }
  .hero__lead { margin-top: 24px; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: #d8d2c6; max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }

  .hero__badges {
    display: flex; flex-wrap: wrap; gap: 10px 24px;
    list-style: none; padding: 0; margin: 36px 0 0;
    font-size: 0.95rem; color: var(--muted);
  }
  .hero__badges li { display: inline-flex; align-items: center; gap: 8px; }
  .hero__badges :global(svg) { color: var(--gold); }

  .hero__media { position: relative; }
  .hero__photo { aspect-ratio: 713 / 816; }
  .hero__slash {
    position: absolute; z-index: -1; right: -40px; bottom: -40px; width: 70%; height: 70%;
    background: repeating-linear-gradient(135deg, var(--red) 0 2px, transparent 2px 14px);
    opacity: 0.35;
  }

  /* entrance animation */
  .hero__content > * { animation: rise 0.8s cubic-bezier(.2,.7,.2,1) both; }
  .hero__content > :nth-child(2) { animation-delay: 0.08s; }
  .hero__content > :nth-child(3) { animation-delay: 0.16s; }
  .hero__content > :nth-child(4) { animation-delay: 0.24s; }
  .hero__content > :nth-child(5) { animation-delay: 0.32s; }
  .hero__media { animation: rise 1s 0.2s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }

  @media (max-width: 860px) {
    .hero { align-items: flex-end; }
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { display: none; }
    .hero__bg img { filter: saturate(0.7) brightness(0.5); transform: none; object-position: 60% 30%; }
    .hero__bg::after {
      background: linear-gradient(180deg, rgba(14,14,14,0.35) 0%, rgba(14,14,14,0.75) 45%, var(--bg) 100%);
    }
    .hero__actions .btn { flex: 1 1 100%; }
  }
</style>
