---
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const d = t(Astro.props.lang);
---

<section id="training" class="section section--alt texture">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="label">{d.disciplines.label}</p>
      <h2 class="h2">{d.disciplines.title}</h2>
      <p class="lead">{d.disciplines.intro}</p>
    </div>

    <div class="cards">
      {d.disciplines.items.map((item, i) => (
        <article class:list={['card reveal', { 'card--featured': i === 2 }]} style={`transition-delay:${i * 90}ms`}>
          <span class="card__icon" aria-hidden="true">{item.icon}</span>
          <p class="card__kicker">{item.kicker}</p>
          <h3 class="card__title">{item.title}</h3>
          <p class="card__text">{item.text}</p>
          <ul class="card__tags">
            {item.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; position: relative; }
  .card {
    position: relative; display: flex; flex-direction: column;
    padding: 36px 30px 30px;
    background: var(--surface);
    clip-path: var(--chamfer);
    transition: transform 0.7s ease, opacity 0.7s ease, background 0.3s, translate 0.3s;
  }
  .card::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(201, 162, 74, 0.12), transparent 40%);
    opacity: 0; transition: opacity 0.3s;
  }
  .card:hover { background: var(--surface-2); translate: 0 -4px; }
  .card:hover::before { opacity: 1; }
  .card--featured { background: linear-gradient(160deg, #2a0d0f 0%, var(--surface) 60%); }

  .card__icon {
    width: 64px; height: 64px; display: grid; place-items: center;
    font-size: 2rem; background: var(--bg); border: 1px solid var(--line);
    clip-path: polygon(30% 0, 70% 0, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0 70%, 0 30%);
  }
  .card__kicker {
    margin-top: 24px; font-family: var(--font-head); font-size: 0.85rem;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--red-2);
  }
  .card__title { font-size: 1.75rem; margin-top: 6px; }
  .card__text { color: var(--muted); margin-top: 14px; flex: 1; }
  .card__tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 24px 0 0; }
  .card__tags li {
    font-size: 0.8rem; letter-spacing: 0.06em; padding: 4px 12px;
    border: 1px solid var(--line); color: var(--gold-2);
  }

  @media (max-width: 920px) {
    .cards { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
  }
</style>
