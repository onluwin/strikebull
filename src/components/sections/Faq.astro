---
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const d = t(Astro.props.lang);
---

<section id="faq" class="section">
  <div class="container faq">
    <div class="faq__head reveal">
      <p class="label">{d.faq.label}</p>
      <h2 class="h2">{d.faq.title}</h2>
      <a href="#contact" class="btn faq__cta">{d.hero.cta}</a>
    </div>

    <div class="faq__list reveal">
      {d.faq.items.map((item, i) => (
        <details class="faq__item" name="faq" open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <Icon name="plus" size={22} class="faq__icon" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .faq__head { position: sticky; top: calc(var(--header-h) + 32px); }
  .faq__cta { margin-top: 32px; }

  .faq__item { border-bottom: 1px solid var(--line-soft); }
  .faq__item:first-child { border-top: 1px solid var(--line-soft); }
  .faq__item summary {
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding: 22px 0; cursor: pointer; list-style: none;
    font-family: var(--font-head); font-size: 1.2rem; letter-spacing: 0.03em;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--gold-2); }
  .faq__item :global(.faq__icon) { color: var(--gold); flex-shrink: 0; transition: transform 0.3s; }
  .faq__item[open] :global(.faq__icon) { transform: rotate(45deg); color: var(--red-2); }
  .faq__item p { padding: 0 40px 24px 0; color: var(--muted); }

  @media (max-width: 860px) {
    .faq { grid-template-columns: 1fr; }
    .faq__head { position: static; }
    .faq__cta { display: none; }
  }
</style>
