---
import { Image } from 'astro:assets';
import { t, type Lang } from '../../i18n';
import photo from '../../../images/photo1.png';

interface Props { lang: Lang }
const d = t(Astro.props.lang);
---

<section id="about" class="section">
  <div class="container about">
    <div class="about__media reveal">
      <div class="frame">
        <div class="photo about__photo">
          <Image src={photo} alt={d.gallery.alt[0]} widths={[480, 716]} sizes="(max-width: 860px) 100vw, 45vw" />
        </div>
      </div>
    </div>

    <div class="about__text reveal">
      <p class="label">{d.about.label}</p>
      <h2 class="h2">{d.about.title}</h2>
      <p class="about__p">{d.about.p1}</p>
      <p class="about__p">{d.about.p2}</p>

      <dl class="stats">
        {d.about.stats.map((s) => (
          <div class="stats__item">
            <dt>{s.label}</dt>
            <dd class="gold-text">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 7vw, 96px); align-items: center; }
  .about__photo { aspect-ratio: 4 / 4.4; }
  .about__p { color: var(--muted); margin-top: 20px; max-width: 58ch; }
  .about__p:first-of-type { margin-top: 28px; color: var(--text); font-size: 1.15rem; }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 40px 0 0; }
  .stats__item {
    display: flex; flex-direction: column-reverse; gap: 6px;
    padding: 20px 18px; background: var(--surface); border-top: 2px solid var(--red);
  }
  .stats dd { margin: 0; font-family: var(--font-head); font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 700; line-height: 1; }
  .stats dt { font-size: 0.85rem; color: var(--muted); line-height: 1.3; }

  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; }
    .about__photo { aspect-ratio: 4 / 3; }
    .about__photo :global(img) { object-position: 50% 60%; }
  }
  @media (max-width: 420px) {
    .stats { gap: 8px; }
    .stats__item { padding: 16px 12px; }
  }
</style>
